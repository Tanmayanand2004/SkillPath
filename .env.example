# ========================================
# AI/LLM API Keys (REQUIRED)
# ========================================

# Groq API Key - free tier option for AI model interactions
GROQ_API_KEY=
DEFAULT_PROVIDER=groq
DEFAULT_MODEL=openai/gpt-oss-20b
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# OpenAI API Key - optional paid fallback
OPENAI_API_KEY=

# Anthropic API Key - optional paid provider; unused in the free setup
ANTHROPIC_API_KEY=

# Perplexity AI API Key - optional paid feature; leave empty for free deployment
PERPLEXITY_API_KEY=
# Optional: choose a specific Perplexity model (e.g. pplx-7b-online, pplx-70b-chat)
# PERPLEXITY_MODEL=pplx-7b-online
# Optional: Perplexity pricing (USD per 1K tokens) for cost tracking
PERPLEXITY_PROMPT_COST_PER_1K=0.0
PERPLEXITY_COMPLETION_COST_PER_1K=0.0

# ========================================
# Model Configuration
# ========================================

# Optional: Configure local embedding settings
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
HF_TOKEN=
# MAX_TOKENS=1000
# TEMPERATURE=0.7

# ========================================
# Flask Configuration
# ========================================

# Development environment settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_SECRET_KEY=your-secret-key-change-in-production
DEBUG=True

# Port (Render will set this automatically)
PORT=5000

# ========================================
# Database Configuration
# ========================================

# Supabase pooled Postgres connection string. For local development, leave empty
# to use SQLite.
SUPABASE_DATABASE_URL=
DATABASE_URL=

# ========================================
# Redis Configuration
# ========================================

# Redis URL - optional. Leave empty for the free single-service prototype.
REDIS_URL=

# Alternative Redis configuration (for local development)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========================================
# Google OAuth Configuration
# ========================================

# Google OAuth credentials (obtain from Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ========================================
# Observability & Monitoring (OPTIONAL)
# ========================================

# LangSmith Configuration (for LLM tracing and debugging)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-learning-path-generator

# Weights & Biases Configuration (for metrics and experiment tracking)
WANDB_API_KEY=
WANDB_PROJECT=ai-learning-path-generator
WANDB_ENTITY=
WANDB_MODE=disabled

# ========================================
# Other Configuration
# ========================================

# Enable mock backend data for UI testing (set to True locally only)
ENABLE_MOCK_DATA=False
DEV_MODE=False

# Vector DB path (local ChromaDB)
VECTOR_DB_PATH=./vector_db
RESOURCE_SEARCH_PROVIDER=free
ENABLE_SEMANTIC_CACHE=False
QUERY_REWRITE_ENABLED=True
CONTEXTUAL_COMPRESSION_ENABLED=True
RERANK_ENABLED=False

# Render environment detection (automatically set by Render)
# RENDER=true
