# ==========================================
# SkillPath Environment Variables Template
# ==========================================
# Instructions:
# 1. Copy this file and rename it to .env
# 2. Fill in the values for the services you are using
# 3. DO NOT commit your actual .env file to version control

# --- AI Models (Groq / OpenAI) ---
GROQ_API_KEY=<YOUR_GROQ_API_KEY_HERE>
DEFAULT_PROVIDER=groq
DEFAULT_MODEL=openai/gpt-oss-20b
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# --- HuggingFace (Embeddings) ---
HF_TOKEN=<YOUR_HUGGINGFACE_TOKEN_HERE>
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

# --- Database (Supabase / Postgres) ---
# Use the connection string provided by your database host (e.g. Supabase, Render, local Postgres)
SUPABASE_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<dbname>

# --- Flask Server Configuration ---
FLASK_APP=run.py
FLASK_ENV=development
FLASK_SECRET_KEY=dev-secret-key-change-before-deploy
DEV_MODE=False
DEBUG=True
PORT=5000

# --- SkillPath Features ---
ENABLE_SEMANTIC_CACHE=False
QUERY_REWRITE_ENABLED=False
CONTEXTUAL_COMPRESSION_ENABLED=False
RERANK_ENABLED=False
RESOURCE_SEARCH_PROVIDER=free

# --- Additional Services (Optional) ---
REDIS_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
LANGCHAIN_TRACING_V2=false
WANDB_MODE=disabled
